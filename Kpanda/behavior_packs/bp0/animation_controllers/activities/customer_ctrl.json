{"format_version":"1.10.0","animation_controllers":{"controller.animation.customer_ctrl":{"states":{"default":{"transitions":[{"waiting":"q.property('noxcrew:state') == 'waiting'"},{"eating":"q.property('noxcrew:state') == 'eating'"},{"angry":"q.property('noxcrew:emotion') == 'angry' && q.property('noxcrew:state') != 'leaving'"},{"eating":"q.property('noxcrew:state') == 'eating'"},{"leaving":"q.property('noxcrew:state') == 'leaving'"}]},"waiting":{"transitions":[{"eating":"q.property('noxcrew:state') == 'eating'"},{"angry":"q.property('noxcrew:emotion') == 'angry'"},{"leaving":"q.property('noxcrew:state') == 'leaving'"}]},"eating":{"transitions":[{"leaving":"q.property('noxcrew:state') == 'leaving'"}],"on_entry":["/playsound order_success @a ~ ~ ~ 1 1 0"]},"angry":{"transitions":[{"eating":"q.property('noxcrew:state') == 'eating'"},{"leaving":"q.property('noxcrew:state') == 'leaving'"}],"on_entry":["/playsound customer_hungry @a ~ ~ ~ 1 1 0"]},"leaving":{"transitions":[{"left":"q.property('noxcrew:state') == 'left'"}],"on_entry":["/ride @s stop_riding"]},"left":{"transitions":[{"left":"q.property('noxcrew:state') == 'left'"}],"on_entry":["/function activities/cooking/customer/despawn"]}}}}}