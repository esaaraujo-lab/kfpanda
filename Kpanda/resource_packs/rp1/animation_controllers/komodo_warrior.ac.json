{"format_version":"1.10.0","animation_controllers":{"controller.animation.komodo_warrior.leg_ctrl":{"initial_state":"idle","states":{"idle":{"animations":["idle_legs"],"transitions":[{"run":"q.ground_speed > 1.0"},{"skitter_idle":"variable.spear == 0"}],"blend_transition":0.2},"run":{"animations":["run_legs"],"transitions":[{"idle":"q.ground_speed < 0.5"},{"skitter":"variable.spear == 0"}],"blend_transition":0.2},"skitter_idle":{"animations":["skitter_idle"],"transitions":[{"skitter":"q.ground_speed > 1.0"},{"idle":"variable.spear == 1"}],"blend_transition":0.2},"skitter":{"animations":["skitter"],"transitions":[{"skitter_idle":"q.ground_speed < 0.5"},{"run":"variable.spear == 1"}],"blend_transition":0.2}}},"controller.animation.komodo_warrior.arm_ctrl":{"initial_state":"idle","states":{"idle":{"animations":["idle_arms"],"transitions":[{"run":"q.ground_speed > 1.0"},{"attack":"query.is_delayed_attacking"},{"throw":"query.is_charged"}],"blend_transition":0.2},"run":{"animations":["run_arms"],"transitions":[{"idle":"q.ground_speed < 0.5"},{"attack":"query.is_delayed_attacking"},{"throw":"query.is_charged"}],"blend_transition":0.2},"attack":{"animations":["attack"],"transitions":[{"idle":"q.any_animation_finished && q.ground_speed < 0.75"},{"run":"q.any_animation_finished && q.ground_speed >= 0.75"}],"blend_transition":0.2},"throw":{"animations":["throw"],"transitions":[{"skitter":"q.any_animation_finished"}],"blend_transition":0.2},"skitter":{"transitions":[{"grab_spear":"q.property('noxcrew:has_spear')"}]},"grab_spear":{"animations":["grab_spear"],"transitions":[{"idle":"q.any_animation_finished && q.ground_speed < 0.75"},{"run":"q.any_animation_finished && q.ground_speed >= 0.75"}]}}}}}