{"format_version":"1.10.0","animation_controllers":{"controller.animation.wolf_munchable.ctrl":{"initial_state":"default","states":{"default":{"transitions":[{"idle":"!q.property('noxcrew:knockout')"},{"munched":"q.property('noxcrew:knockout')"}]},"idle":{"animations":[{"idle1":"variable.random == 1"},{"idle2":"variable.random == 2"},{"idle3":"variable.random == 3"}],"transitions":[{"munch":"q.property('noxcrew:knockout')"},{"walk":"q.modified_move_speed > 0.01 && !q.property('noxcrew:scared')"},{"run_away":"(q.modified_move_speed > 0.01 || q.property('noxcrew:tutorial')) && q.property('noxcrew:scared')"}],"blend_transition":0.15},"walk":{"animations":["walk"],"transitions":[{"munch":"q.property('noxcrew:knockout')"},{"idle":"q.modified_move_speed <= 0.01"},{"run_away":"q.property('noxcrew:scared')"}],"blend_transition":0.15},"run_away":{"animations":["run_away"],"transitions":[{"munch":"q.property('noxcrew:knockout')"},{"idle":"q.modified_move_speed <= 0.01 && !q.property('noxcrew:tutorial')"},{"walk":"!q.property('noxcrew:scared') && !q.property('noxcrew:tutorial')"}],"blend_transition":0.15},"munch":{"animations":["munch"],"transitions":[{"munched":"query.any_animation_finished"}]},"munched":{"animations":["munched"],"transitions":[{"get_up":"!q.property('noxcrew:knockout')"}]},"get_up":{"animations":["get_up"],"transitions":[{"idle":"query.any_animation_finished"}],"blend_transition":0.15}}}}}