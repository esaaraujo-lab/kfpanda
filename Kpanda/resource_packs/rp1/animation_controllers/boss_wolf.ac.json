{"format_version":"1.10.0","animation_controllers":{"controller.animation.boss_wolf.ctrl":{"initial_state":"idle","states":{"idle":{"animations":["idle"],"transitions":[{"run":"q.ground_speed > 1.0"},{"slam":"q.property('noxcrew:attack.type') == 'slam'"},{"arrow_call":"q.property('noxcrew:attack.type') == 'arrow'"}],"blend_transition":0.15},"run":{"animations":["run"],"transitions":[{"idle":"q.ground_speed < 0.5"},{"slam":"q.property('noxcrew:attack.type') == 'slam'"},{"arrow_call":"q.property('noxcrew:attack.type') == 'arrow'"}],"blend_transition":0.15},"slam":{"animations":["slam"],"transitions":[{"idle":"q.any_animation_finished && q.ground_speed < 0.5"},{"run":"q.any_animation_finished && q.ground_speed > 1.0"}]},"arrow_call":{"animations":["arrow_call"],"transitions":[{"idle":"q.any_animation_finished && q.ground_speed < 0.5"},{"run":"q.any_animation_finished && q.ground_speed > 1.0"}]}}},"controller.animation.boss_wolf.attack_ctrl":{"initial_state":"default","states":{"default":{"transitions":[{"attack":"query.is_delayed_attacking"}],"blend_transition":0.15},"attack":{"animations":["attack"],"transitions":[{"default":"query.any_animation_finished"}],"blend_transition":0.15}}},"controller.animation.boss_wolf.death_ctrl":{"initial_state":"default","states":{"default":{"transitions":[{"death":"query.health == 0.0"}]},"death":{"particle_effects":[{"effect":"metal_scatter"}]}}}}}