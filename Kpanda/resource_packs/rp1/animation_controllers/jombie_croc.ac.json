{"format_version":"1.10.0","animation_controllers":{"controller.animation.jombie_croc.move_ctrl":{"initial_state":"idle","states":{"idle":{"animations":["idle"],"transitions":[{"run":"q.ground_speed > 1.0 && q.property('noxcrew:is_standing')"},{"attack":"query.is_delayed_attacking && q.property('noxcrew:is_standing')"},{"crawl_idle":"!q.property('noxcrew:is_standing')"}],"blend_transition":0.2},"run":{"animations":["run"],"transitions":[{"idle":"q.ground_speed < 0.5 && q.property('noxcrew:is_standing')"},{"attack":"query.is_delayed_attacking && q.property('noxcrew:is_standing')"},{"crawl":"!q.property('noxcrew:is_standing')"}],"blend_transition":0.2},"attack":{"animations":["attack"],"transitions":[{"idle":"q.any_animation_finished && q.ground_speed < 0.5"},{"run":"q.any_animation_finished && q.ground_speed > 1.0"}],"blend_transition":0.2,"blend_via_shortest_path":true},"crawl_idle":{"animations":["crawl_idle"],"transitions":[{"crawl":"q.ground_speed > 1.0"},{"idle":"q.property('noxcrew:is_standing')"}],"blend_transition":0.2},"crawl":{"animations":["crawl"],"transitions":[{"crawl_idle":"q.ground_speed < 0.5"},{"run":"q.property('noxcrew:is_standing')"}],"blend_transition":0.2}}},"controller.animation.jombie_croc.attack_ctrl":{"initial_state":"default","states":{"default":{"transitions":[{"bite":"query.is_delayed_attacking && !q.property('noxcrew:is_standing')"}],"blend_transition":0.2},"bite":{"animations":["bite"],"transitions":[{"default":"variable.bite == 1"}],"blend_transition":0.2}}}}}