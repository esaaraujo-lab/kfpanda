{
	"namespace": "nox_boss_out",
	"factory": {
		"type": "panel",
		"factory": {
			"name": "hud_title_text_factory",
			"control_ids": {
				"hud_title_text": "boss@nox_boss_out.root_panel"
			}
		}
	},
	"root_panel": {
		"type": "panel",
		"$is_visible|default": false,
		"visible": "$is_visible",
		//	"$bar_wait|default": 5,
		"variables": [
			{
				"requires": "((not ($title_text - 'nox:boss' = $title_text)))",
				"$is_visible": true
			}
		],
		"controls": [
			{
				"boss_out@panels": {}
			},
			{
				"boss_text@panels_text": {}
			}
		]
	},
	"bar_top": {
		"type": "image",
		"texture": "textures/ui/noxcrew/letterbox/black",
		"size": ["200%", "50%"],
		"offset": [0, "-25%"],
		"$bar_wait|default": 20,
		"layer": 1000
	},
	"bar_btm": {
		"type": "image",
		"texture": "textures/ui/noxcrew/letterbox/black",
		"size": ["200%", "50%"],
		"offset": [0, "25%"],
		"$bar_wait|default": 20,
		"layer": 1000
	},
	"boss_text": {
		"type": "label",
		"text": "$boss_name",
		"font_size": "large",
		"localize": true,
		"font_type": "MinecraftTen",
		"shadow": true,
		"layer": 1001,
		"$text_wait|default": 25,
		"offset": [0, "50%"],
		"color": [0.8, 0.3, 0.2]
	},
	"panels_text": {
		"type": "panel",
		"size": ["350%", "150%"],
		"$boss_name|default": "???",
		"anchor_from": "bottom_middle",
		"anchor_to": "bottom_middle",
		"controls": [
			{
				"text@boss_text": {
					"alpha": 0,
					"$anim|default": "nox_boss_out.anim_none",
					"variables": [
						{
							"requires": "((not ($title_text - 'nox:boss_out_tai' = $title_text)))",
							"$anim": "nox_boss_out.anim_in_text",
							"$boss_name": "txt.tai_lung.end",
							"$text_wait": 22
						},
						{
							"requires": "((not ($title_text - 'nox:boss_out_shen' = $title_text)))",
							"$anim": "nox_boss_out.anim_in_text",
							"$boss_name": "txt.lord_shen.end",
							"$text_wait": 27
						},
						{
							"requires": "((not ($title_text - 'nox:boss_out_fail' = $title_text)))",
							"$anim": "nox_boss_out.anim_in_text",
							"$boss_name": "txt.boss_shen.fail",
							"$text_wait": 2
						},
						{
							"requires": "((not ($title_text - 'nox:boss_out_kai' = $title_text)))",
							"$anim": "nox_boss_out.anim_in_text",
							"$boss_name": "txt.general_kai.end",
							"$text_wait": 32
						},
						{
							"requires": "((not ($title_text - 'nox:boss_out_chameleon' = $title_text)))",
							"$anim": "nox_boss_out.anim_in_text",
							"$boss_name": "txt.chameleon.end",
							"$text_wait": 37.5
						}
					],
					"anims": ["@$anim"]
				}
			}
		]
	},
	"panels": {
		"type": "panel",
		"size": ["350%", "150%"],
		"anchor_from": "center",
		"anchor_to": "center",
		"controls": [
			{
				"_bar_top@bar_top": {
					"alpha": 0,
					"$anim|default": "nox_boss_out.anim_none",
					"variables": [
						{
							"requires": "((not ($title_text - 'nox:boss_out_tai' = $title_text)))",
							"$anim": "nox_boss_out.anim_in_top",
							"$bar_wait": 18
						},
						{
							"requires": "((not ($title_text - 'nox:boss_out_shen' = $title_text)))",
							"$anim": "nox_boss_out.anim_in_top",
							"$bar_wait": 23
						},
						{
							"requires": "((not ($title_text - 'nox:boss_out_fail' = $title_text)))",
							"$anim": "nox_boss_out.anim_in_fail_top",
							"$bar_wait": 0
						},
						{
							"requires": "((not ($title_text - 'nox:boss_out_kai' = $title_text)))",
							"$anim": "nox_boss_out.anim_in_top",
							"$bar_wait": 28
						},
						{
							"requires": "((not ($title_text - 'nox:boss_out_chameleon' = $title_text)))",
							"$anim": "nox_boss_out.anim_in_top",
							"$bar_wait": 33.5
						}
					],
					"anims": ["@$anim"]
				}
			},
			{
				"_bar_btm@bar_btm": {
					"alpha": 0,
					"$anim|default": "nox_boss_out.anim_none",
					"variables": [
						{
							"requires": "((not ($title_text - 'nox:boss_out_tai' = $title_text)))",
							"$anim": "nox_boss_out.anim_in_btm",
							"$bar_wait": 18
						},
						{
							"requires": "((not ($title_text - 'nox:boss_out_shen' = $title_text)))",
							"$anim": "nox_boss_out.anim_in_btm",
							"$bar_wait": 23
						},
						{
							"requires": "((not ($title_text - 'nox:boss_out_fail' = $title_text)))",
							"$anim": "nox_boss_out.anim_in_fail_btm",
							"$bar_wait": 0
						},
						{
							"requires": "((not ($title_text - 'nox:boss_out_kai' = $title_text)))",
							"$anim": "nox_boss_out.anim_in_btm",
							"$bar_wait": 28
						},
						{
							"requires": "((not ($title_text - 'nox:boss_out_chameleon' = $title_text)))",
							"$anim": "nox_boss_out.anim_in_btm",
							"$bar_wait": 33.5
						}
					],
					"anims": ["@$anim"]
				}
			}
		]
	},
	// anims
	"anim_none": {
		"anim_type": "wait",
		"duration": 0
	},
	//top
	"anim_in_top": {
		"anim_type": "wait",
		"duration": 0,
		"next": "@nox_boss_out.anim_in_top_1"
	},
	"anim_in_top_1": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 0,
		"next": "@nox_boss_out.anim_in_top_2"
	},
	"anim_in_top_2": {
		"anim_type": "offset",
		"easing": "in_out_quint",
		"from": [0, "-75%"],
		"to": [0, "-50%"],
		"duration": 2,
		"next": "@nox_boss_out.anim_in_top_3"
	},
	"anim_in_top_3": {
		"anim_type": "wait",
		"duration": "$bar_wait",
		"next": "@nox_boss_out.anim_in_top_4"
	},
	"anim_in_top_4": {
		"anim_type": "offset",
		"easing": "in_out_quint",
		"from": [0, "-50%"],
		"to": [0, "-25%"],
		"duration": 2
	},

	//fail
	"anim_in_fail_top": {
		"anim_type": "wait",
		"duration": 0,
		"next": "@nox_boss_out.anim_in_fail_top_1"
	},
	"anim_in_fail_top_1": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 0,
		"next": "@nox_boss_out.anim_in_fail_top_2"
	},
	"anim_in_fail_top_2": {
		"anim_type": "offset",
		"easing": "in_out_quint",
		"from": [0, "-75%"],
		"to": [0, "-25%"],
		"duration": 2
	},
	//bottom
	"anim_in_btm": {
		"anim_type": "wait",
		"duration": 0,
		"next": "@nox_boss_out.anim_in_btm_1"
	},
	"anim_in_btm_1": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 0,
		"next": "@nox_boss_out.anim_in_btm_2"
	},
	"anim_in_btm_2": {
		"anim_type": "offset",
		"easing": "in_out_quint",
		"from": [0, "75%"],
		"to": [0, "48%"],
		"duration": 2,
		"next": "@nox_boss_out.anim_in_btm_3"
	},
	"anim_in_btm_3": {
		"anim_type": "wait",
		"duration": "$bar_wait",
		"next": "@nox_boss_out.anim_in_btm_4"
	},
	"anim_in_btm_4": {
		"anim_type": "offset",
		"easing": "in_out_quint",
		"from": [0, "48%"],
		"to": [0, "25%"],
		"duration": 2
	},

	//fail
	"anim_in_fail_btm": {
		"anim_type": "wait",
		"duration": 0,
		"next": "@nox_boss_out.anim_in_fail_btm_1"
	},
	"anim_in_fail_btm_1": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 0,
		"next": "@nox_boss_out.anim_in_fail_btm_2"
	},
	"anim_in_fail_btm_2": {
		"anim_type": "offset",
		"easing": "in_out_quint",
		"from": [0, "75%"],
		"to": [0, "25%"],
		"duration": 2
	},
	// Text
	"anim_in_text": {
		"anim_type": "wait",
		"duration": "$text_wait",
		"next": "@nox_boss_out.anim_in_text_1"
	},
	"anim_in_text_1": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 0,
		"next": "@nox_boss_out.anim_in_text_2"
	},
	"anim_in_text_2": {
		"anim_type": "offset",
		"easing": "out_cubic",
		"from": ["0%", "0%"],
		"to": ["0%", "5%"],
		"duration": 1,
		"next": "@nox_boss_out.anim_in_text_3"
	},
	"anim_in_text_3": {
		"anim_type": "wait",
		"duration": 4,
		"next": "@nox_boss_out.anim_in_text_4"
	},
	"anim_in_text_4": {
		"anim_type": "alpha",
		"easing": "out_cubic",
		"from": 1,
		"to": 0,
		"duration": 0.5
	}
}
