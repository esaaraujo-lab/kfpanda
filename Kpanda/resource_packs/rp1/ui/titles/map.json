	// anims
	"anim_none": {
		"anim_type": "wait",
		"duration": 0
	},
	// Background
	"anim_background_in": {
		"anim_type": "wait",
		"duration": 0,
		"next": "@nox_map.anim_background_fade"
	},
	"anim_background_fade": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 1,
		"next": "@nox_map.anim_background_wait"
	},
	"anim_background_wait": {
		"anim_type": "wait",
		"duration": 10,
		"next": "@nox_map.anim_background_out"
	},
	"anim_background_out": {
		"anim_type": "alpha",
		"from": 1,
		"to": 0,
		"duration": 1
	},
	// text
	"anim_text_in": {
		"anim_type": "offset",
		"from": "($location)",
		"to": "($location)",
		"duration": 0,
		"next": "@nox_map.anim_text_fade"
	},
	"anim_text_fade": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 1,
		"next": "@nox_map.anim_text_wait"
	},
	"anim_text_wait": {
		"anim_type": "wait",
		"duration": 10,
		"next": "@nox_map.anim_text_out"
	},
	"anim_text_out": {
		"anim_type": "alpha",
		"from": 1,
		"to": 0,
		"duration": 1
	},
	// icon
	"anim_icon": {
		"anim_type": "wait",
		"duration": 0,
		"next": "@nox_map.anim_icon_set_pos"
	},
	"anim_icon_set_pos": {
		"anim_type": "offset",
		"from": "($start_location)",
		"to": "($start_location)",
		"duration": 0,
		"next": "@nox_map.anim_icon_in_fade"
	},
	"anim_icon_in_fade": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 1,
		"next": "@nox_map.anim_icon_move"
	},
	"anim_icon_move": {
		"anim_type": "offset",
		"easing": "in_quad",
		"from": "($start_location)",
		"to": "($end_location)",
		"duration": 6,
		"next": "@nox_map.anim_icon_wait"
	},
	"anim_icon_wait": {
		"anim_type": "wait",
		"duration": 4,
		"next": "@nox_map.anim_icon_out"
	},
	"anim_icon_out": {
		"anim_type": "alpha",
		"from": 1,
		"to": 0,
		"duration": 1
	}
}
