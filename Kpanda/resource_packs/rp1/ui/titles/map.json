{
	"namespace": "nox_map",
	"factory": {
		"type": "panel",
		"factory": {
			"name": "hud_title_text_factory",
			"control_ids": {
				"hud_title_text": "map@nox_map.root_panel"
			}
		}
	},
	"root_panel": {
		"type": "panel",
		"$is_visible|default": false,
		// Take the image Ratio, then do 100/R, the X by the pixel the location is in to get the ration of the image the icon sits. Take that number and minus 50, to get the offset.
		// So an offset of 660 in an 1280px image. ( (100/1280)*660 = 51.562) - 50 = 1.562%
		//
		//academy
		"$loc_a|default": ["22.65%", "2.777%"],
		"$txt_a|default": ["36.156%", "0.972%"],
		//jade palce
		"$loc_j|default": ["-1.953%", "16.666%"],
		"$txt_j|default": ["-7%", "17%"],
		//valley of peace
		"$loc_v|default": ["3.125%", "33.333%"],
		"$txt_v|default": ["5%", "35%"],
		//gongmen city
		"$loc_g|default": ["8.593%", "-22.222%"],
		"$txt_g|default": ["18.3%", "-28%"],
		//panda village
		"$loc_p|default": ["3.125%", "8.333%"],
		"$txt_p|default": ["-4.2%", "10.3%"],
		//harbour
		"$loc_h|default": ["-9.375%", "-15.277%"],
		"$txt_h|default": ["-22.7%", "-11.5%"],
		//castle
		"$loc_c|default": ["-11.715%", "-32.2%"],
		"visible": "$is_visible",
		"variables": [
			{
				"requires": "((not ($title_text - 'nox:map' = $title_text)))",
				"$is_visible": true
			}
		],
		"controls": [
			{
				"background@background_panel": {}
			},
			{
				"icon@icon_panel": {}
			}
		]
	},
	"safe_background": {
		"type": "image",
		"texture": "textures/ui/noxcrew/letterbox/black",
		"keep_ratio": false,
		"size": ["300%", "300%"],
		"layer": 1000
	},
	"map_background": {
		"type": "image",
		"texture": "textures/ui/noxcrew/map/background",
		"keep_ratio": false,
		"layer": 1100
