	"background_panel": {
		"type": "panel",
		"anchor_from": "center",
		"anchor_to": "center",
		"controls": [
			{
				"safe_back@safe_background": {
					"alpha": 0,
					"$anim|default": "nox_map.anim_none",
					"variables": [
						{
							"requires": "((not ($title_text - 'nox:map_' = $title_text)))",
							"$anim": "nox_map.anim_background_in"
						}
					],
					"anims": ["@$anim"]
				}
			},
			{
				"map_back@map_background": {
					"alpha": 0,
					"$anim|default": "nox_map.anim_none",
					"variables": [
						{
							"requires": "((not ($title_text - 'nox:map_' = $title_text)))",
							"$anim": "nox_map.anim_background_in"
						}
					],
					"anims": ["@$anim"]
				}
			},
			{
				"text_academy@map_text_academy": {
					"alpha": 0,
					"$anim|default": "nox_map.anim_none",
					"variables": [
						{
							"requires": "((not ($title_text - 'nox:map_' = $title_text)))",
							"$location": "($txt_a)",
							"$anim": "nox_map.anim_text_in"
						}
					],
					"anims": ["@$anim"]
				}
			},
			{
				"text_jade@map_text_jade": {
