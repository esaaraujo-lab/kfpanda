{
	"namespace": "nox_popup",
	"factory": {
		"type": "panel",
		"factory": {
			"name": "hud_title_text_factory",
			"control_ids": {
				"hud_title_text": "popup@nox_popup.root_panel"
			}
		}
	},
	"root_panel": {
		"type": "panel",
		"$is_visible|default": false,
		"visible": "$is_visible",
		"$popup_name|default": "invisible",
		"$background_name|default": "invisible",
		"size": ["100%", "100%"],
		"variables": [
			{
				"requires": "((not ($title_text - 'nox:popup' = $title_text)))",
				"$is_visible": true
			}
		],
		"controls": [
			{
				"popup@panels": {}
			},

			{
				"backgrounds@backgrounds_panels": {}
			}
		]
	},
	"popup_image": {
		"type": "image",
		"texture": "('textures/ui/noxcrew/popup/' + $popup_name)",
		"layer": 1000,
		"$anchor_from|default": "center",
		"$anchor_to|default": "center",
		"$in_easing|default": "spring",
		"$in_from|default": 0,
		"$in_to|default": 1,
		"$in_duration|default": 0.5,
		"$wait_duration|default": 0.3,
		"$out_easing|default": "out_cubic",
		"$out_from|default": 1,
		"$out_to|default": 0,
		"$out_duration": 0.25,
		"$anim_scale|default": "nox_popup.anim_scale_in",
		"$anim_alpha|default": "nox_popup.anim_alpha_in",
		"$custom_size|default": [100, 100],
		"$custom_offset|default": [0, 0],
		"anchor_from": "($anchor_from)",
		"anchor_to": "($anchor_to)",
		"offset": "($custom_offset)"
	},
	"background_image": {
		"type": "image",
		"texture": "('textures/ui/noxcrew/popup/' + $popup_name)",
		"layer": 900,
		"size": ["200%", "200%"],
		"$anchor_from|default": "center",
		"$anchor_to|default": "center",
		"$in_easing|default": "spring",
		"$in_from|default": 0,
		"$in_to|default": 1,
		"$in_duration|default": 0.5,
		"$wait_duration|default": 0.3,
		"$out_easing|default": "out_cubic",
		"$out_from|default": 1,
		"$out_to|default": 0,
		"$out_duration": 0.25,
		"$anim_offset|default": "nox_popup.anim_offset_in",
		"$anim_alpha|default": "nox_popup.anim_alpha_in",
		"$custom_offset|default": [0, 0],
		"anchor_from": "($anchor_from)",
		"anchor_to": "($anchor_to)",
		"offset": "($custom_offset)"
	},
	"panels": {
		"type": "panel",
		"controls": [
			{
				"_popup_image@popup_image": {
					"alpha": 0,
					"variables": [
						{
							"requires": "((not ($title_text - 'nox:popup_countdown1' = $title_text)))",
							"$popup_name": "countdown1",
							"$is_visible": true
						},
						{
							"requires": "((not ($title_text - 'nox:popup_countdown2' = $title_text)))",
							"$popup_name": "countdown2",
							"$is_visible": true
						},
						{
							"requires": "((not ($title_text - 'nox:popup_countdown3' = $title_text)))",
							"$popup_name": "countdown3",
							"$is_visible": true
						},
						{
							"requires": "((not ($title_text - 'nox:popup_go' = $title_text)))",
							"$popup_name": "go",
							"$in_easing": "in_cubic",
							"$in_duration": 0.4,
							"$wait_duration": 1,
							"$custom_size": ["70%", "70%"],
							"$is_visible": true
						},
						{
							"requires": "((not ($title_text - 'nox:popup_end' = $title_text)))",
							"$popup_name": "end",
							"$in_easing": "in_cubic",
							"$in_duration": 0.4,
							"$wait_duration": 1,
							"$custom_size": ["80%", "80%"],
							"$is_visible": true
						},
						{
							"requires": "((not ($title_text - 'nox:popup_munchwolf1' = $title_text)))",
							"$popup_name": "munchwolf1",
							"$custom_offset": ["10%", "-15%"],
							"$is_visible": true,
							"$in_duration": 0.4,
							"$wait_duration": 2,
							"$out_easing": "linear",
							"$out_duration": 2
						},
						{
							"requires": "((not ($title_text - 'nox:popup_munchwolf2' = $title_text)))",
							"$popup_name": "munchwolf2",
							"$custom_offset": ["15%", "10%"],
							"$is_visible": true,
							"$in_duration": 0.4,
							"$wait_duration": 2,
							"$out_easing": "linear",
							"$out_duration": 2
						},
						{
							"requires": "((not ($title_text - 'nox:popup_munchwolf3' = $title_text)))",
							"$popup_name": "munchwolf3",
							"$custom_offset": ["-15%", "-10%"],
							"$is_visible": true,
							"$in_duration": 0.4,
							"$wait_duration": 2,
							"$out_easing": "linear",
							"$out_from": 1,
							"$out_to": 0,
							"$out_duration": 2
						},
						{
							"requires": "((not ($title_text - 'nox:popup_ping1' = $title_text)))",
							"$popup_name": "ping1",
							"$anchor_from": "bottom_right",
							"$anchor_to": "bottom_right",
							"$is_visible": true,
							"$custom_size": ["55%", "55%"],
							"$custom_offset": ["10%", "10px"],
							"$in_duration": 0.4,
							"$wait_duration": 1,
							"$out_easing": "in_cubic",
							"$out_duration": 0.5
						},
						{
							"requires": "((not ($title_text - 'nox:popup_ping2' = $title_text)))",
							"$popup_name": "ping2",
							"$anchor_from": "bottom_right",
							"$anchor_to": "bottom_right",
							"$is_visible": true,
							"$custom_size": ["55%", "55%"],
							"$custom_offset": ["10%", "10px"],
							"$in_duration": 0.4,
							"$wait_duration": 1,
							"$out_easing": "in_cubic",
							"$out_duration": 0.5
						},
						{
							"requires": "((not ($title_text - 'nox:popup_dumpling' = $title_text)))",
							"$popup_name": "dumpling",
							"$anchor_from": "bottom_right",
							"$anchor_to": "bottom_right",
							"$is_visible": true,
							"$custom_size": ["45%", "45%"],
							"$custom_offset": ["5%", "0px"],
							"$in_duration": 0.1,
							"$in_easing": "out_circ",
							"$wait_duration": 1,
							"$out_easing": "in_cubic",
							"$out_duration": 0.5
						}
					],
					"$anim|default": "nox_popup.anim_none",
					"anims": ["@$anim_scale", "@$anim_alpha"]
				}
			}
		]
	},
	"backgrounds_panels": {
		"type": "panel",
		"controls": [
			{
				"_popup_background@background_image": {
					"alpha": 0,
					"variables": [
						{
							"requires": "((not ($title_text - 'nox:popup_go' = $title_text)))",
							"$popup_name": "brushstroke",
							"$in_easing": "in_out_cubic",
							"$wait_duration": 0.9,

							"$is_visible": true
						},
						{
							"requires": "((not ($title_text - 'nox:popup_end' = $title_text)))",
							"$popup_name": "brushstroke",
							"$in_easing": "in_out_cubic",
							"$wait_duration": 0.9,
							"$is_visible": true
						}
					],
					"$anim|default": "nox_popup.anim_none",
					"anims": ["@$anim_offset", "@$anim_alpha"]
				}
			}
		]
	},
	//
	//
	//
	"anim_none": {
		"anim_type": "wait",
		"duration": 0
	},
	"anim_alpha_in": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 0.5,
		"easing": "linear"
	},
	"anim_offset_in": {
		"anim_type": "offset",
		"from": ["100%", "-100%"],
		"to": ["0%", "0%"],
		"duration": "$in_duration",
		"easing": "$in_easing",
		"next": "@nox_popup.anim_wait"
	},
	"anim_scale_in": {
		"anim_type": "size",
		"from": [0, 0],
		"to": "($custom_size)",
		"duration": "$in_duration",
		"easing": "$in_easing",
		"next": "@nox_popup.anim_wait"
	},
	"anim_wait": {
		"anim_type": "wait",
		"duration": "$wait_duration",
		"next": "@nox_popup.anim_out"
	},
	"anim_out": {
		"anim_type": "alpha",
		"easing": "$out_easing",
		"from": "$out_from",
		"to": "$out_to",
		"duration": "$out_duration"
	}
}
