{
	"namespace": "nox_area",
	"factory": {
		"type": "panel",
		"factory": {
			"name": "hud_title_text_factory",
			"control_ids": {
				"hud_title_text": "area@nox_area.root_panel"
			}
		}
	},
	"root_panel": {
		"type": "panel",
		"$is_visible|default": false,
		"visible": "$is_visible",
		"variables": [
			{
				"requires": "((not ($title_text - 'nox:area' = $title_text)))",
				"$is_visible": true
			}
		],
		"controls": [
			{
				"area_in@panels": {}
			},
			{
				"area_text@panels_text": {}
			}
		]
	},
	"bar_top": {
		"type": "image",
		"texture": "textures/ui/noxcrew/letterbox/black",
		"size": ["200%", "50%"],
		"offset": [0, "-25%"],
		"layer": 1000
	},
	"bar_btm": {
		"type": "image",
		"texture": "textures/ui/noxcrew/letterbox/black",
		"size": ["200%", "50%"],
		"offset": [0, "25%"],
		"layer": 1000
	},
	"area_text": {
		"type": "label",
		"text": "$area_name",
		"font_size": "large",
		"localize": true,
		"font_type": "MinecraftTen",
		"shadow": true,
		"layer": 1001,
		"offset": [0, "50%"],
		"color": "($color)"
	},
	"panels_text": {
		"type": "panel",
		"size": ["350%", "150%"],
		"$color|default": [0.784, 0.996, 0.976],
		"$area_name|default": "test",
		"anchor_from": "bottom_right",
		"anchor_to": "bottom_right",
		"controls": [
			{
				"text@area_text": {
					"alpha": 0,
					"$anim|default": "nox_area.anim_none",
					"variables": [
						{
							"requires": "((not ($title_text - 'nox:area_in_palace' = $title_text)))",
							"$anim": "nox_area.anim_in_text",
							"$area_name": "txt.title.jade_palace"
						},
						{
							"requires": "((not ($title_text - 'nox:area_in_peace' = $title_text)))",
							"$anim": "nox_area.anim_in_text",
							"$area_name": "txt.title.valley_of_peace"
						},
						{
							"requires": "((not ($title_text - 'nox:area_in_gongmen' = $title_text)))",
							"$anim": "nox_area.anim_in_text",
							"$area_name": "txt.title.gongmen_city"
						},
						{
							"requires": "((not ($title_text - 'nox:area_in_village' = $title_text)))",
							"$anim": "nox_area.anim_in_text",
							"$area_name": "txt.title.panda_village"
						},
						{
							"requires": "((not ($title_text - 'nox:area_in_harbor' = $title_text)))",
							"$anim": "nox_area.anim_in_text",
							"$area_name": "txt.title.harbor"
						},
						{
							"requires": "((not ($title_text - 'nox:area_in_castle' = $title_text)))",
							"$anim": "nox_area.anim_in_text",
							"$area_name": "txt.title.castle"
						},
						{
							"requires": "((not ($title_text - 'nox:area_in_spirit_realm' = $title_text)))",
							"$anim": "nox_area.anim_in_text",
							"$area_name": "txt.title.spirit_realm",
							"$color": [0.784, 0.396, 0.376]
						}
					],
					"anims": ["@$anim"]
				}
			}
		]
	},
	"panels": {
		"type": "panel",
		"size": ["350%", "150%"],
		"anchor_from": "center",
		"anchor_to": "center",
		"controls": [
			{
				"_bar_top@bar_top": {
					"alpha": 0,
					"$anim|default": "nox_area.anim_none",
					"variables": [
						{
							"requires": "((not ($title_text - 'nox:area_in' = $title_text)))",
							"$anim": "nox_area.anim_in_top"
						}
					],
					"anims": ["@$anim"]
				}
			},
			{
				"_bar_btm@bar_btm": {
					"alpha": 0,
					"$anim|default": "nox_area.anim_none",
					"variables": [
						{
							"requires": "((not ($title_text - 'nox:area_in' = $title_text)))",
							"$anim": "nox_area.anim_in_btm"
						}
					],
					"anims": ["@$anim"]
				}
			}
		]
	},
	// anims
	"anim_none": {
		"anim_type": "wait",
		"duration": 0
	},
	// in top
	"anim_in_top": {
		"anim_type": "wait",
		"duration": 0,
		"next": "@nox_area.anim_in_top_1"
	},
	"anim_in_top_1": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 0,
		"next": "@nox_area.anim_in_top_2"
	},
	"anim_in_top_2": {
		"anim_type": "offset",
		"easing": "out_cubic",
		"from": [0, "-75%"],
		"to": [0, "-50%"],
		"duration": 1,
		"next": "@nox_area.anim_wait_top"
	},
	"anim_wait_top": {
		"anim_type": "wait",
		"duration": 4.8,
		"next": "@nox_area.anim_out_top_2"
	},
	// out top
	"anim_out_top_2": {
		"anim_type": "alpha",
		"from": 1,
		"to": 0,
		"duration": 1
	},
	//bottom
	// in bottom
	"anim_in_btm": {
		"anim_type": "wait",
		"duration": 0,
		"next": "@nox_area.anim_in_btm_1"
	},
	"anim_in_btm_1": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 0,
		"next": "@nox_area.anim_in_btm_2"
	},
	"anim_in_btm_2": {
		"anim_type": "offset",
		"easing": "out_cubic",
		"from": [0, "75%"],
		"to": [0, "50%"],
		"duration": 1,
		"next": "@nox_area.anim_wait_btm"
	},
	"anim_wait_btm": {
		"anim_type": "wait",
		"duration": 4.8,
		"next": "@nox_area.anim_out_btm_2"
	},
	// out bottom ,
	"anim_out_btm_2": {
		"anim_type": "alpha",
		"from": 1,
		"to": 0,
		"duration": 1
	},
	// Text
	"anim_in_text": {
		"anim_type": "wait",
		"duration": 0,
		"next": "@nox_area.anim_in_text_1"
	},
	"anim_in_text_1": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 0,
		"next": "@nox_area.anim_in_text_2"
	},
	"anim_in_text_2": {
		"anim_type": "offset",
		"easing": "out_cubic",
		"from": ["70%", "45%"],
		"to": ["45%", "45%"],
		"duration": 2,
		"next": "@nox_area.anim_wait_text"
	},
	"anim_wait_text": {
		"anim_type": "wait",
		"duration": 2.7,
		"next": "@nox_area.anim_out_text"
	},
	"anim_out_text": {
		"anim_type": "alpha",
		"easing": "in_quint",
		"from": 1,
		"to": 0,
		"duration": 0.35
	}
}
