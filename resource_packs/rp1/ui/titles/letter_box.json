{
	"namespace": "nox_letterbox",
	"factory": {
		"type": "panel",
		"factory": {
			"name": "hud_title_text_factory",
			"control_ids": {
				"hud_title_text": "letterbox@nox_letterbox.root_panel"
			}
		}
	},
	"root_panel": {
		"type": "panel",
		"$is_visible|default": false,
		"visible": "$is_visible",
		"variables": [
			{
				"requires": "((not ($title_text - 'nox:letterbox' = $title_text)))",
				"$is_visible": true
			}
		],
		"controls": [
			{
				"letterbox_in@panels": {}
			}
		]
	},
	"bar_top": {
		"type": "image",
		"texture": "textures/ui/noxcrew/letterbox/black",
		"size": ["300%", "50%"],
		"offset": [0, "-25%"],
		"layer": 100000
	},
	"bar_btm": {
		"type": "image",
		"texture": "textures/ui/noxcrew/letterbox/black",
		"size": ["150%", "50%"],
		"offset": [0, "25%"],
		"layer": 100000
	},
	"panels": {
		"type": "panel",
		"size": ["350%", "150%"],
		"anchor_from": "center",
		"anchor_to": "center",
		"controls": [
			{
				"_bar_top@bar_top": {
					"alpha": 0,
					"$anim|default": "nox_letterbox.anim_none",
					"variables": [
						{
							"requires": "((not ($title_text - 'nox:letterbox_open' = $title_text)))",
							"$anim": "nox_letterbox.anim_open_top"
						},
						{
							"requires": "((not ($title_text - 'nox:letterbox_in' = $title_text)))",
							"$anim": "nox_letterbox.anim_in_top"
						},
						{
							"requires": "((not ($title_text - 'nox:letterbox_instant' = $title_text)))",
							"$anim": "nox_letterbox.anim_instant_top"
						},
						{
							"requires": "((not ($title_text - 'nox:letterbox_out' = $title_text)))",
							"$anim": "nox_letterbox.anim_out_top"
						},
						{
							"requires": "((not ($title_text - 'nox:letterbox_stasis' = $title_text)))",
							"$anim": "nox_letterbox.anim_stasis_top"
						}
					],
					"anims": ["@$anim"]
				}
			},
			{
				"_bar_btm@bar_btm": {
					"alpha": 0,
					"$anim|default": "nox_letterbox.anim_none",
					"variables": [
						{
							"requires": "((not ($title_text - 'nox:letterbox_open' = $title_text)))",
							"$anim": "nox_letterbox.anim_open_btm"
						},
						{
							"requires": "((not ($title_text - 'nox:letterbox_in' = $title_text)))",
							"$anim": "nox_letterbox.anim_in_btm"
						},
						{
							"requires": "((not ($title_text - 'nox:letterbox_instant' = $title_text)))",
							"$anim": "nox_letterbox.anim_instant_btm"
						},
						{
							"requires": "((not ($title_text - 'nox:letterbox_out' = $title_text)))",
							"$anim": "nox_letterbox.anim_out_btm"
						},
						{
							"requires": "((not ($title_text - 'nox:letterbox_stasis' = $title_text)))",
							"$anim": "nox_letterbox.anim_stasis_btm"
						}
					],
					"anims": ["@$anim"]
				}
			}
		]
	},
	// anims
	"anim_none": {
		"anim_type": "wait",
		"duration": 0
	},
	// open top
	"anim_open_top": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 1,
		"next": "@nox_letterbox.anim_open_top_1"
	},
	"anim_open_top_1": {
		"anim_type": "wait",
		"duration": 4,
		"next": "@nox_letterbox.anim_open_top_2"
	},
	"anim_open_top_2": {
		"anim_type": "offset",
		"easing": "in_out_quint",
		"from": [0, "-25%"],
		"to": [0, "-48%"],
		"duration": 3
	},
	// in top
	"anim_in_top": {
		"anim_type": "wait",
		"duration": 0,
		"next": "@nox_letterbox.anim_in_top_1"
	},
	"anim_in_top_1": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 0,
		"next": "@nox_letterbox.anim_in_top_2"
	},
	"anim_in_top_2": {
		"anim_type": "offset",
		"easing": "out_cubic",
		"from": [0, "-75%"],
		"to": [0, "-48%"],
		"duration": 1
	},
	// in instant
	"anim_instant_top": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 0,
		"next": "@nox_letterbox.anim_instant_top_1"
	},
	"anim_instant_top_1": {
		"anim_type": "offset",
		"from": [0, "-75%"],
		"to": [0, "-48%"],
		"duration": 0
	},
	// out top
	"anim_out_top": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 0,
		"next": "@nox_letterbox.anim_out_top_1"
	},
	"anim_out_top_1": {
		"anim_type": "wait",
		"duration": 0,
		"next": "@nox_letterbox.anim_out_top_2"
	},
	"anim_out_top_2": {
		"anim_type": "offset",
		"easing": "out_cubic",
		"from": [0, "-48%"],
		"to": [0, "-75%"],
		"duration": 1,
		"next": "@nox_letterbox.anim_out_top_3"
	},
	"anim_out_top_3": {
		"anim_type": "alpha",
		"from": 1,
		"to": 0,
		"duration": 1
	},
	// stasis top
	"anim_stasis_top": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 1,
		"next": "@nox_letterbox.anim_stasis_top_1"
	},
	"anim_stasis_top_1": {
		"anim_type": "wait",
		"duration": 0,
		"next": "@nox_letterbox.anim_stasis_top_2"
	},
	"anim_stasis_top_2": {
		"anim_type": "offset",
		"easing": "in_out_quint",
		"from": [0, "-75%"],
		"to": [0, "-50%"]
	},
	//bottom
	//open bottom
	"anim_open_btm": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 1,
		"next": "@nox_letterbox.anim_open_btm_1"
	},
	"anim_open_btm_1": {
		"anim_type": "wait",
		"duration": 4,
		"next": "@nox_letterbox.anim_open_btm_2"
	},
	"anim_open_btm_2": {
		"anim_type": "offset",
		"easing": "in_out_quint",
		"from": [0, "25%"],
		"to": [0, "48%"],
		"duration": 3
	},
	// in bottom
	"anim_in_btm": {
		"anim_type": "wait",
		"duration": 0,
		"next": "@nox_letterbox.anim_in_btm_1"
	},
	"anim_in_btm_1": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 0,
		"next": "@nox_letterbox.anim_in_btm_2"
	},
	"anim_in_btm_2": {
		"anim_type": "offset",
		"easing": "out_cubic",
		"from": [0, "75%"],
		"to": [0, "48%"],
		"duration": 1
	},
	// instant bottom
	"anim_instant_btm": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 0,
		"next": "@nox_letterbox.anim_instant_btm_1"
	},
	"anim_instant_btm_1": {
		"anim_type": "offset",
		"from": [0, "75%"],
		"to": [0, "48%"],
		"duration": 0
	},
	// out bottom ,
	"anim_out_btm": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 0,
		"next": "@nox_letterbox.anim_out_btm_1"
	},
	"anim_out_btm_1": {
		"anim_type": "wait",
		"duration": 0,
		"next": "@nox_letterbox.anim_out_btm_2"
	},
	"anim_out_btm_2": {
		"anim_type": "offset",
		"easing": "out_cubic",
		"from": [0, "48%"],
		"to": [0, "75%"],
		"duration": 1,
		"next": "@nox_letterbox.anim_out_btm_3"
	},
	"anim_out_btm_3": {
		"anim_type": "alpha",
		"from": 1,
		"to": 0,
		"duration": 1
	},
	//stasis btm
	"anim_stasis_btm": {
		"anim_type": "alpha",
		"from": 0,
		"to": 1,
		"duration": 1,
		"next": "@nox_letterbox.anim_stasis_btm_1"
	},
	"anim_stasis_btm_1": {
		"anim_type": "wait",
		"duration": 0,
		"next": "@nox_letterbox.anim_stasis_btm_2"
	},
	"anim_stasis_btm_2": {
		"anim_type": "offset",
		"easing": "in_out_quint",
		"from": [0, "75%"],
		"to": [0, "50%"],
		"duration": 1
	}
}
