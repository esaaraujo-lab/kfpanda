{
	"namespace": "hud",
	"horse_heart_renderer": {
		"ignored": true
	},
	"mob_effects_renderer": {
		"ignored": true
	},
	"hunger_renderer": {
		"ignored": true
	},

	"hud_screen": {
		"render_only_when_topmost": false,
		"$screen_animations": [],
		"$background_animations": []
	},
	"root_panel": {
		"type": "panel",
		"variables": [
			{
				"requires": "$education_edition",
				"$left_helpers": "hud.left_helpers_edu"
			},
			{
				"requires": "(not $education_edition)",
				"$left_helpers": "hud.left_helpers"
			}
		],
		"modifications": [
			{
				"array_name": "controls",
				"operation": "insert_front",
				"value": [{ "hud@custom_overlay": {} }]
			}
		]
	},
	"hud_title_text": {
		"visible": "(($title_text - 'nox:') = $title_text))",
		"offset": [0, 0]
	},
	"custom_overlay": {
		"type": "panel",
		"controls": [
			{
				"nox_area_intro@nox_area.factory": {}
			},
			{
				"nox_area_a_intro@nox_area_a.factory": {}
			},
			{
				"nox_brand@nox_brand.factory": {}
			},
			{
				"nox_boss_intro@nox_boss.factory": {}
			},
			{
				"nox_boss_outro@nox_boss_out.factory": {}
			},
			{
				"nox_letterbox@nox_boss_title.factory": {}
			},
			{
				"nox_boss_title@nox_letterbox.factory": {}
			},
			{
				"nox_map@nox_map.factory": {}
			},
			{
				"nox_popup@nox_popup.factory": {}
			}
		]
	}
}
