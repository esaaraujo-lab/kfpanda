{"format_version":"1.10.0","animation_controllers":{"controller.animation.big_fun.fight_ctrl":{"initial_state":"appear","states":{"appear":{"animations":["appear"],"transitions":[{"idle":"q.ground_speed < 0.5 && query.any_animation_finished"},{"run":"q.ground_speed > 1.0 && query.any_animation_finished"}],"blend_transition":1},"idle":{"animations":["idle"],"transitions":[{"run":"q.ground_speed > 1.0"},{"squeeze":"query.has_rider"}],"blend_transition":0.5},"run":{"animations":["run"],"transitions":[{"idle":"q.ground_speed < 0.5"},{"squeeze":"query.has_rider"}],"blend_transition":0.5},"squeeze":{"animations":["squeeze"],"transitions":[{"idle":"q.ground_speed < 0.75 && !query.has_rider"},{"run":"q.ground_speed >= 0.75 && !query.has_rider"}],"blend_transition":0.5}}}}}