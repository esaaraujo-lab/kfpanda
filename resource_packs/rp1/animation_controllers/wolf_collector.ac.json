{"format_version":"1.10.0","animation_controllers":{"controller.animation.wolf_collector.ctrl":{"initial_state":"idle","states":{"idle":{"animations":["idle"],"transitions":[{"run":"q.ground_speed > 1.0"},{"collect":"q.property('noxcrew:collect')"}],"blend_transition":0.2},"run":{"animations":["run"],"transitions":[{"idle":"q.ground_speed < 0.5"},{"collect":"q.property('noxcrew:collect')"}],"blend_transition":0.2},"collect":{"animations":["collect"],"transitions":[{"idle":"q.any_animation_finished && q.ground_speed < 0.5"},{"run":"q.any_animation_finished && q.ground_speed > 1.0"}],"blend_transition":0.2}}}}}